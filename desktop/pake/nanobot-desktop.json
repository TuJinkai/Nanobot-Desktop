/* ===================================================================
   Pake configuration for nanobot Desktop
   ===================================================================

   This JSON file documents the pake-cli arguments used to build the
   nanobot desktop wrapper.  The build is automated by build_all.py.

   To build manually:

       npm install -g pake-cli
       pake http://127.0.0.1:24691 \
           --name nanobot \
           --width 1200 \
           --height 800 \
           --icon desktop/assets/nanobot.ico

   =================================================================== */

{
  "name": "nanobot",
  "version": "0.3.0",
  "url": "http://127.0.0.1:24691",
  "window": {
    "title": "nanobot",
    "width": 1200,
    "height": 800,
    "min_width": 800,
    "min_height": 600,
    "resizable": true,
    "fullscreen": false,
    "transparent": false,
    "always_on_top": false,
    "hide_title_bar": false
  },
  "platforms": ["windows", "macos", "linux"],
  "inject": [],
  "icon": "../assets/nanobot.ico"
}
